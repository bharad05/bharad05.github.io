	<script>
	(function () {
		var bg2022 = document.getElementById('bg-2022');
		var labelL = document.getElementById('bg-label-left');
		var labelR = document.getElementById('bg-label-right');
		var pos = 50;
		var target = 50;
		var ticking = false;

		function getX(e) {
			if (e.touches && e.touches.length > 0) return e.touches[0].clientX;
			if (e.changedTouches && e.changedTouches.length > 0) return e.changedTouches[0].clientX;
			return null;
		}

		function update(x) {
			if (typeof x !== 'number') return;
			target = Math.max(0, Math.min(100, (x / window.innerWidth) * 100));
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(step);
			}
		}

		function apply() {
			var pct = pos.toFixed(3) + '%';
			if (bg2022) {
				bg2022.style.clipPath = 'inset(0 0 0 ' + pct + ')';
				bg2022.style.webkitClipPath = 'inset(0 0 0 ' + pct + ')';
			}
			if (labelL) labelL.style.opacity = pos < 15 ? (pos / 15).toFixed(2) : '1';
			if (labelR) labelR.style.opacity = pos > 85 ? ((100 - pos) / 15).toFixed(2) : '1';
		}

		function step() {
			pos += (target - pos) * 0.12;
			apply();

			if (Math.abs(target - pos) > 0.1) {
				requestAnimationFrame(step);
			} else {
				pos = target;
				apply();
				ticking = false;
			}
		}

		document.addEventListener('mousemove', function (e) {
			update(e.clientX);
		});

		document.addEventListener('touchstart', function (e) {
			update(getX(e));
		}, { passive: true });

		document.addEventListener('touchmove', function (e) {
			update(getX(e));
		}, { passive: true });

		apply();
	})();
	</script>

